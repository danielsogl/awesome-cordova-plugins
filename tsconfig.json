{
  "compilerOptions": {
    "declaration": true,
    "stripInternal": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    // Plugin methods are decorator stubs (`method(): Promise<T> { return; }`) whose bodies are
    // replaced at build time, so every one of them is a strictNullChecks error by design (~2700).
    "strictNullChecks": false,
    // TypeScript 6 no longer auto-includes every @types package; they must be listed.
    "types": ["cordova"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      "@awesome-cordova-plugins/core": ["./dist/@awesome-cordova-plugins/core"]
    },
    "outDir": "./dist",
    "rootDir": "src",
    "target": "es2022",
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "inlineSources": true,
    "inlineSourceMap": true
  },
  "include": ["src/@awesome-cordova-plugins/plugins/**/*.ts"],
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
